// Cloudflare Worker serving docs/ as static assets.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "linkdocs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
